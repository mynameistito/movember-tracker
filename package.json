{
  "name": "shaggedy-movember",
  "version": "1.0.0",
  "description": "Cloudflare Worker to scrape Movember donation amounts using HTML parsing",
  "keywords": [
    "cloudflare",
    "movember",
    "scraper",
    "workers"
  ],
  "license": "MIT",
  "author": "",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --remote",
    "deploy": "wrangler deploy",
    "typecheck": "tsrs --noEmit && tsrs --noEmit -p tsconfig.worker.json && tsrs --noEmit -p tsconfig.scripts.json",
    "tail": "bunx wrangler tail --format json",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "build:js": "esbuild src/client/movember-scraper.ts --bundle --minify --sourcemap --outfile=public/js/bundle.js --format=esm --target=es2020 && esbuild src/client/setup.ts src/client/overlay.ts --bundle --minify --outdir=public/js --format=esm --target=es2020",
    "build": "npm run build:js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:local": "bun run scripts/test-local.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@tanstack/query-core": "^5.106.1",
    "effect": "^4.0.0-beta.107"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@shadcn/lint": "^0.2.3",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "happy-dom": "^21.0.4",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-plugin-react-doctor": "^0.9.21",
    "oxlint-tsgolint": "^7.0.2005",
    "tsrs": "^0.22.0-ts7.1.0-beta",
    "ultracite": "8.1.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
